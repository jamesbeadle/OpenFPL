# Copy to .env.local for local dev and fill in.
# .env.local is git-ignored.

# Supabase — find in your Supabase project: Settings → API
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Service role key — server-only. NEVER expose to the client.
# Used by Edge Functions and server-side admin operations.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# FootballGod API
FOOTBALLGOD_API_URL=https://api.footballgod.example
FOOTBALLGOD_API_KEY=YOUR-FG-API-KEY
FOOTBALLGOD_WEBHOOK_SECRET=YOUR-FG-WEBHOOK-SIGNING-SECRET

# Optional: Google OAuth (configured in Supabase Auth dashboard, not here)
# These are placeholders for reference only — actual config lives in Supabase.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
